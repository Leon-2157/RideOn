# ==============================================================================
# Customer App Environment Variables
# Duplikat file ini menjadi `.env` di folder apps/customer_app/
# ==============================================================================

APP_NAME=RideOn Customer
APP_PACKAGE=com.rideon.customer
APP_ENV=development

# Firebase Web Client ID (Untuk Google Sign-In Android)
FIREBASE_WEB_CLIENT_ID=770832884584-4f0b1v13bh8v65ovo97v3hd3bpvdktlq.apps.googleusercontent.com

# Google Maps API Key untuk Flutter Map & Places Autocomplete
GOOGLE_MAPS_API_KEY=YOUR_CUSTOMER_GOOGLE_MAPS_API_KEY

# Base URLs
API_BASE_URL=https://api.rideon.id/v1
PAYMENT_CLIENT_KEY=SB-Mid-client-XXXXX
