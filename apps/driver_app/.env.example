# ==============================================================================
# Driver App Environment Variables
# Duplikat file ini menjadi `.env` di folder apps/driver_app/
# ==============================================================================

APP_NAME=RideOn Driver
APP_PACKAGE=com.rideon.driver
APP_ENV=development

# Firebase Web Client ID
FIREBASE_WEB_CLIENT_ID=770832884584-4f0b1v13bh8v65ovo97v3hd3bpvdktlq.apps.googleusercontent.com

# Navigation & Tracking API Keys
GOOGLE_MAPS_API_KEY=YOUR_DRIVER_GOOGLE_MAPS_API_KEY
DIRECTIONS_API_KEY=YOUR_DIRECTIONS_API_KEY

# Background Tracking Frequency (in seconds)
GPS_UPDATE_INTERVAL_SECONDS=5
