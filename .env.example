# ==============================================================================
# RideOn Monorepo - Global Environment Variables Template
# Copy file ini menjadi `.env` jika memerlukan konfigurasi global bersama
# ==============================================================================

# Mode Environment: development | staging | production
APP_ENV=development

# Backend API Base URLs (Jika menggunakan Cloud Functions / API Server)
API_BASE_URL=https://api.rideon.id/v1
ORACLE_CLOUD_STORAGE_URL=https://objectstorage.ap-singapore-1.oraclecloud.com/n/...

# Firebase Web Client ID (Untuk Google Sign-In)
FIREBASE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Map & Geolocation API Keys
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# WhatsApp Business API (Untuk OTP WhatsApp)
WHATSAPP_API_ENDPOINT=https://api.whatsapp.com/v1/messages
WHATSAPP_API_TOKEN=YOUR_WHATSAPP_BUSINESS_TOKEN

# Payment Gateway (Midtrans / Xendit Sandbox)
PAYMENT_GATEWAY_CLIENT_KEY=SB-Mid-client-XXXXX
PAYMENT_GATEWAY_ENV=sandbox
