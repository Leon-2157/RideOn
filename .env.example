# General & Ports
TZ=Asia/Jakarta
APP_ENV=development
NODE_ENV=production
NGINX_HTTP_PORT=8088
PUBLIC_BASE_URL=http://localhost:8088
NEXT_PUBLIC_API_BASE_URL=http://localhost:8088

# MySQL 8.0 (container init uses MYSQL_*, services connect with DB_*)
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=rideon_root_secret
MYSQL_DATABASE=rideon_db
MYSQL_USER=rideon
MYSQL_PASSWORD=rideon_secret

# JWT Authentication
JWT_SECRET=change-me-rideon-jwt-secret-key-min-32-chars
JWT_EXPIRES_HOURS=168

# Firebase (Auth, RTDB, FCM) & Google Sign-In
FIREBASE_PROJECT_ID=rideon-lhokseumawe
FIREBASE_DATABASE_URL=https://rideon-lhokseumawe-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-service-account.json
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=rideon-lhokseumawe.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://rideon-lhokseumawe-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=rideon-lhokseumawe

# Email OTP (Resend primary + Gmail App Password failover & 2-way CS)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@rideons.app
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Maps & Routing (OSRM & Nominatim)
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# WhatsApp Gateway (Baileys)
WHATSAPP_GATEWAY_SECRET=rideon-wa-internal-secret
GATEWAY_SANDBOX_MODE=true

# PayG Dynamic QRIS Engine
PAYG_WEBHOOK_SECRET=rideon-payg-internal-secret
PAYG_STATIC_QRIS=
QRIS_EXPIRE_MINUTES=15

# AI Service (AES-256-GCM key must be 32 bytes)
AI_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Business Rules
DRIVER_OFFER_SECONDS=16
DRIVER_NEGATIVE_BALANCE_LIMIT=20000
WITHDRAW_ADMIN_FEE=2000
